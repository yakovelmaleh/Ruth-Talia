<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="<%= text(site.seo.description) %>">
  <meta name="theme-color" content="<%= site.theme.ink %>">
  <title><%= text(site.seo.title) %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;500;600&family=Cormorant+Garamond:wght@400;500;600&family=Heebo:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/site.css">
  <style>:root{--ink:<%= site.theme.ink %>;--paper:<%= site.theme.paper %>;--cream:<%= site.theme.cream %>;--rose:<%= site.theme.rose %>;--sage:<%= site.theme.sage %>}</style>
</head>
<body>
  <div class="announcement"><%= text(site.copy.announcement) %></div>
  <header>
    <button class="mobile-menu-button" type="button" data-menu-open aria-label="<%= lang === 'he' ? 'פתיחת תפריט' : 'Open menu' %>">☰</button>
    <nav>
      <a href="#collection"><%= lang === "he" ? "קולקציה" : "Collection" %></a>
      <a href="#story"><%= lang === "he" ? "הסיפור" : "Our story" %></a>
      <a href="#atelier"><%= lang === "he" ? "האטלייה" : "The atelier" %></a>
    </nav>
    <a class="brand" href="/?lang=<%= lang %>"><strong><%= site.brand.name %></strong><small><%= text(site.brand.descriptor) %></small></a>
    <div class="header-actions">
      <a class="language" href="/?lang=<%= lang === 'he' ? 'en' : 'he' %>"><%= lang === "he" ? "EN" : "HE" %></a>
      <button class="bag-button" type="button" data-cart-open><%= lang === "he" ? "סל" : "Bag" %> <span data-cart-count><%= cart.items.reduce((sum, item) => sum + item.quantity, 0) %></span></button>
    </div>
  </header>

  <aside class="mobile-menu" data-mobile-menu>
    <button type="button" data-menu-close>×</button>
    <a href="#collection"><%= lang === "he" ? "קולקציה" : "Collection" %></a>
    <a href="#story"><%= lang === "he" ? "הסיפור שלנו" : "Our story" %></a>
    <a href="#atelier"><%= lang === "he" ? "האטלייה" : "The atelier" %></a>
    <a href="#appointment"><%= lang === "he" ? "קביעת פגישה" : "Book an appointment" %></a>
  </aside>

  <main>
    <section class="hero" style="--hero-image:url('<%= site.images.hero %>')">
      <div class="hero-content">
        <p class="eyebrow"><%= text(site.copy.heroEyebrow) %></p>
        <h1><%= text(site.copy.heroTitle) %></h1>
        <p><%= text(site.copy.heroText) %></p>
        <div class="actions">
          <a class="button light" href="#collection"><%= lang === "he" ? "לגלות את הקולקציה" : "Discover the collection" %></a>
          <a class="button outline" href="#appointment"><%= lang === "he" ? "לקבוע מדידה אישית" : "Book a private fitting" %></a>
        </div>
      </div>
    </section>

    <section class="story split" id="story">
      <div class="visual" style="background-image:url('<%= site.images.story %>')"></div>
      <div class="copy">
        <p class="eyebrow"><%= lang === "he" ? "האישה שמאחורי המותג" : "The woman behind the label" %></p>
        <h2><%= text(site.copy.storyTitle) %></h2>
        <p><%= text(site.copy.storyText) %></p>
        <div class="signature">Ruth Talia</div>
      </div>
    </section>

    <section class="collection section" id="collection">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow"><%= lang === "he" ? "קולקציית החותם" : "The signature collection" %></p>
          <h2><%= text(site.copy.collectionTitle) %></h2>
        </div>
        <div class="filters">
          <% const categories = lang === "he" ? {all:"הכול",bridal:"כלות",evening:"ערב",signature:"סיגנצ׳ר"} : {all:"All",bridal:"Bridal",evening:"Evening",signature:"Signature"}; %>
          <% Object.entries(categories).forEach(([key, label]) => { %>
            <button type="button" class="<%= key === 'all' ? 'active' : '' %>" data-filter="<%= key %>"><%= label %></button>
          <% }) %>
        </div>
        <div class="product-grid">
          <% products.forEach(product => { %>
            <article class="product" data-category="<%= product.category %>">
              <button class="product-image" type="button" data-product-open="<%= product.id %>">
                <img src="<%= product.imageUrl %>" alt="<%= lang === 'he' ? product.nameHe : product.nameEn %>" loading="lazy">
                <% if (lang === "he" ? product.badgeHe : product.badgeEn) { %>
                  <span><%= lang === "he" ? product.badgeHe : product.badgeEn %></span>
                <% } %>
              </button>
              <div class="product-details">
                <h3><%= lang === "he" ? product.nameHe : product.nameEn %></h3>
                <strong><%= product.price === null ? (lang === "he" ? "מחיר לפי בקשה" : "Price on request") : new Intl.NumberFormat(lang === "he" ? "he-IL" : "en-IL", {style:"currency",currency:"ILS",maximumFractionDigits:0}).format(product.price) %></strong>
                <p><%= lang === "he" ? product.subtitleHe : product.subtitleEn %></p>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="gallery section" id="gallery">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow"><%= lang === "he" ? "הגלריה" : "The gallery" %></p>
          <h2><%= lang === "he" ? "רגעים של יופי, תנועה וסגנון." : "Moments of beauty, movement, and style." %></h2>
        </div>
        <div class="gallery-grid">
          <% site.gallery.forEach((item, index) => { %>
            <figure class="gallery-item gallery-item-<%= index + 1 %>"><img src="<%= item.imageUrl %>" alt="<%= text(item.caption) %>" loading="lazy"><figcaption><%= text(item.caption) %></figcaption></figure>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="manifesto"><blockquote>“<%= text(site.copy.manifesto) %>”</blockquote></section>

    <section class="atelier split reverse" id="atelier">
      <div class="visual" style="background-image:url('<%= site.images.atelier %>')"></div>
      <div class="copy">
        <p class="eyebrow"><%= lang === "he" ? "חוויית הקוטור" : "The couture experience" %></p>
        <h2><%= text(site.copy.atelierTitle) %></h2>
        <% const steps = lang === "he"
          ? [["השיחה","הסיפור שלך, האירוע והדרך שבה תרצי להרגיש."],["הצללית","גזרה שמחמיאה ומעניקה חופש תנועה."],["היצירה","בדים איכותיים, עבודת יד וסדרת מדידות."],["הרגע שלך","כל קו מדויק, בלי להתפשר על נוחות."]]
          : [["The conversation","Your story, your event, and how you want to feel."],["The silhouette","A shape that celebrates you and moves freely."],["The making","Fine fabrics, hand finishing, and personal fittings."],["Your moment","Every line refined, without compromising comfort."]]; %>
        <ol class="steps">
          <% steps.forEach(step => { %><li><strong><%= step[0] %></strong><span><%= step[1] %></span></li><% }) %>
        </ol>
      </div>
    </section>

    <section class="appointment section" id="appointment">
      <div class="container appointment-grid">
        <div>
          <p class="eyebrow"><%= lang === "he" ? "פגישות אישיות" : "Private appointments" %></p>
          <h2><%= lang === "he" ? "השמלה שלך מתחילה בסיפור שלך." : "Your dress begins with your story." %></h2>
          <p><%= text(site.contact.address) %><br><%= site.contact.phone %><br><%= site.contact.email %></p>
        </div>
        <form data-appointment-form>
          <label><%= lang === "he" ? "שם מלא" : "Full name" %><input name="name" required autocomplete="name"></label>
          <label><%= lang === "he" ? "דוא״ל" : "Email" %><input name="email" type="email" required autocomplete="email"></label>
          <label><%= lang === "he" ? "טלפון" : "Phone" %><input name="phone" required autocomplete="tel"></label>
          <label><%= lang === "he" ? "תאריך האירוע" : "Event date" %><input name="eventDate" type="date"></label>
          <label class="wide"><%= lang === "he" ? "בחירת מועד פנוי" : "Choose an available appointment" %>
            <select name="slotId">
              <option value=""><%= lang === "he" ? "שליחת פנייה ללא מועד" : "Send a request without choosing a slot" %></option>
              <% slots.forEach(slot => { %><option value="<%= slot.id %>"><%= slot.starts_at.replace("T", " ") %> · <%= slot.duration_minutes %> min · <%= slot.location %></option><% }) %>
            </select>
          </label>
          <label><%= lang === "he" ? "אני מחפשת" : "I am looking for" %>
            <select name="occasion"><option value="bridal"><%= lang === "he" ? "שמלת כלה" : "Bridal gown" %></option><option value="evening"><%= lang === "he" ? "שמלת ערב" : "Evening dress" %></option><option value="custom"><%= lang === "he" ? "עיצוב אישי" : "Custom creation" %></option></select>
          </label>
          <label class="wide"><%= lang === "he" ? "ספרי לנו על השמלה" : "Tell us about your dress" %><textarea name="message"></textarea></label>
          <input type="hidden" name="language" value="<%= lang %>">
          <button class="button" type="submit"><%= lang === "he" ? "שליחת בקשה" : "Send request" %></button>
          <p class="form-status" role="status"></p>
        </form>
      </div>
    </section>
  </main>

  <footer>
    <div><strong><%= site.brand.name %></strong><p><%= text(site.seo.description) %></p></div>
    <div><a href="mailto:<%= site.contact.email %>"><%= site.contact.email %></a><a href="tel:<%= site.contact.phoneLink %>"><%= site.contact.phone %></a><a href="<%= site.contact.instagram %>">Instagram</a></div>
  </footer>

  <div class="overlay" data-overlay></div>
  <aside class="cart" data-cart>
    <div class="drawer-head"><h2><%= lang === "he" ? "הסל שלך" : "Your bag" %></h2><button type="button" data-cart-close>×</button></div>
    <div data-cart-items></div>
    <div class="cart-footer">
      <p><span><%= lang === "he" ? "סכום ביניים" : "Subtotal" %></span><strong data-cart-total></strong></p>
      <small><%= text(site.commerce.shippingNotice) %></small>
      <button class="button" type="button" data-checkout-open><%= lang === "he" ? "המשך להזמנה" : "Continue order" %></button>
    </div>
  </aside>

  <dialog class="product-dialog" data-product-dialog>
    <button class="dialog-close" type="button" data-dialog-close>×</button>
    <div class="product-media" data-product-media>
      <img data-dialog-image alt="">
      <button class="media-arrow previous" type="button" data-image-previous aria-label="Previous image">‹</button>
      <button class="media-arrow next" type="button" data-image-next aria-label="Next image">›</button>
      <div class="media-dots" data-image-dots></div>
    </div>
    <div>
      <p class="eyebrow" data-dialog-category></p>
      <h2 data-dialog-name></h2>
      <strong data-dialog-price></strong>
      <p data-dialog-description></p>
      <div class="sizes">
        <% site.commerce.sizes.forEach(size => { %><button type="button" data-size="<%= size %>"><%= size %></button><% }) %>
      </div>
      <button class="button" type="button" data-add-cart><%= lang === "he" ? "הוספה לסל" : "Add to bag" %></button>
      <a class="button consultation" href="#appointment"><%= lang === "he" ? "לתיאום פגישה" : "Book consultation" %></a>
    </div>
  </dialog>

  <dialog class="checkout-dialog" data-checkout-dialog>
    <button class="dialog-close" type="button" data-checkout-close>×</button>
    <h2><%= lang === "he" ? "השלמת הזמנה" : "Complete your order" %></h2>
    <p><%= lang === "he" ? "זהו תהליך הזמנה שמור. חיבור תשלום יתווסף לפני העלייה לאוויר." : "This creates a saved order. Payment integration will be added before launch." %></p>
    <form data-checkout-form>
      <label><%= lang === "he" ? "שם מלא" : "Full name" %><input name="name" required></label>
      <label><%= lang === "he" ? "דוא״ל" : "Email" %><input name="email" type="email" required></label>
      <label><%= lang === "he" ? "טלפון" : "Phone" %><input name="phone" required></label>
      <button class="button" type="submit"><%= lang === "he" ? "שמירת הזמנה" : "Place order" %></button>
      <p class="form-status" role="status"></p>
    </form>
  </dialog>

  <script>window.STORE_CONTEXT=<%- JSON.stringify({lang, currency:site.commerce.currency, products, cart}) %>;</script>
  <script src="/store.js" defer></script>
</body>
</html>
